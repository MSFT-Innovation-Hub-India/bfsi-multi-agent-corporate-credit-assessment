# Azure Storage Configuration
# Use Azure AD (DefaultAzureCredential) with a managed identity or service principal
AZURE_STORAGE_ACCOUNT_NAME=fsidemo
AZURE_STORAGE_CONTAINER_NAME=creditreport

# Server configuration (optional overrides for uvicorn)
HOST=0.0.0.0
PORT=8000

# Azure AI Project Configuration (Semantic Kernel agents)
AZURE_AI_PROJECT_ENDPOINT=https://eastus2.api.azureml.ms
AZURE_AI_PROJECT_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_AI_PROJECT_RESOURCE_GROUP=fsi-demos
AZURE_AI_PROJECT_NAME=fsi-auto-project

# Azure OpenAI settings (replace with your deployment info)
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_ENDPOINT=https://your-openai-endpoint.openai.azure.com/
AZURE_OPENAI_API_KEY=your_openai_api_key

# Optional: customize API root path when hosting behind a reverse proxy
# ROOT_PATH=/backend

# Optional: set ENVIRONMENT to "production" to disable uvicorn reload
# ENVIRONMENT=production
