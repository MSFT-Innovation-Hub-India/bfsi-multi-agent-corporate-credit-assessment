# Azure Storage Configuration
# Use Azure AD (DefaultAzureCredential) with a managed identity or service principal
AZURE_STORAGE_ACCOUNT_NAME=fsidemo
AZURE_STORAGE_CONTAINER_NAME=creditreport

# Azure Cosmos DB Configuration
AZURE_COSMOS_ENDPOINT=https://fsiauto.documents.azure.com:443/
COSMOS_DATABASE_NAME=creditreport_d
COSMOS_CONTAINER_NAME=creditreport_c

# Server configuration (optional overrides for uvicorn)
HOST=0.0.0.0
PORT=8000

# Azure AI Project Configuration (Semantic Kernel agents)
# Inject this value from an approved secret store at runtime.
PROJECT_CONNECTION_STRING=
MODEL_DEPLOYMENT=gpt-4o-mini

# Azure OpenAI settings
AZURE_OPENAI_ENDPOINT=https://ai-jyothikakoppula117687ai699613618682.openai.azure.com/
# Inject this value from an approved secret store at runtime.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview hosting behind a reverse proxy
# ROOT_PATH=/backend

# Optional: set ENVIRONMENT to "production" to disable uvicorn reload
# ENVIRONMENT=production
